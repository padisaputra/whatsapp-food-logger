# Copy this file to .env and fill in your own values (or run `npm run setup`,
# which writes this file for you interactively). Never commit .env.

# AI backend is your own Claude Code CLI login (Pro or Max subscription) —
# no API key, no metered billing. Run `claude` once on this machine to log in
# before starting the bot. Model alias passed to `claude --model` (e.g.
# "sonnet", "opus", "haiku", or a specific model name).
CLAUDE_MODEL=sonnet

# How long to wait for a single Claude CLI call before giving up (ms).
# Photo analysis is slower than text — the bot already uses a longer internal
# timeout for photos, this is just the outer ceiling.
CLAUDE_TIMEOUT_MS=90000

# Comma-separated list of WhatsApp numbers allowed to use the bot, digits only,
# country code, no "+" and no spaces. Every other number is ignored.
# In multi-client mode each number here gets its own independent log and targets.
# Example: a trainer and two clients. This is only the initial/bootstrap list —
# once the bot is running, the coach can add/remove/pause clients over WhatsApp
# ("add client <number> [name]") or the dashboard without editing this file or
# restarting.
ALLOWED_NUMBERS=10000000000,10000000001,10000000002

# The first number in ALLOWED_NUMBERS that should be treated as the admin/coach.
# Only needed for multi-client mode. Leave blank to disable the "coach summary" command
# and the "add client" / "clients" / "remove client" etc. coach commands.
COACH_NUMBER=10000000000

# Country code (digits only, no "+") used to expand a client number the coach
# enters with a leading "0" instead of a country code, e.g. "add client 0812..."
# becomes "62812..." with DEFAULT_COUNTRY_CODE=62. Leave blank to require the
# coach always enter the full number with country code.
DEFAULT_COUNTRY_CODE=

# IANA timezone used for day boundaries ("today" starts at midnight in this zone).
TZ=UTC

# Default daily targets for anyone without their own "targets set" on file.
# Leave as-is to use these numbers, or let `npm run setup` compute them from
# weight/height/age/goal.
TARGET_KCAL=2000
TARGET_PROTEIN_G=150
TARGET_CARBS_G=200
TARGET_FAT_G=65

# Max messages per client per rolling minute before the bot asks them to slow down.
RATE_LIMIT_PER_MINUTE=20

# Where Baileys stores its WhatsApp login session (gitignored).
AUTH_DIR=./auth

# Where the SQLite database and saved meal photos live (gitignored).
DATA_DIR=./data

# The bot's own WhatsApp number — the one it links as a device on, digits only,
# country code, no "+". Use a spare number, not your main one. `npm run setup`
# asks for this and fills it in; only edit by hand if you're relinking manually.
PAIRING_NUMBER=

# --- Advanced (optional) — the defaults are fine for almost everyone ---

# How many Claude CLI calls can run at once (e.g. several photos arriving
# together). Higher uses more CPU/RAM per machine; lower queues them.
CLAUDE_CLI_CONCURRENCY=2

# Log verbosity: "info" (default), "debug", "warn", or "error". Logs never
# include message text or photo contents either way.
LOG_LEVEL=info

# Only set this if `claude` isn't found automatically (rare) — the full path
# to the Claude Code CLI binary, e.g. /usr/local/bin/claude.
CLAUDE_BIN=
